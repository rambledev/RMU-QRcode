generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  phone      String
  userType   String
  department String?
  faculty    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  qrCodes    QRCode[]

  @@map("users")
}

model QRCode {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  content     String
  contentType String
  label       String?
  qrDataUrl   String   @db.Text
  createdAt   DateTime @default(now())
  ipAddress   String?

  @@map("qr_codes")
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  action    String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("usage_logs")
}